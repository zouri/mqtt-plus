{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "qt6.11-debug",
      "displayName": "Qt 6.11 macOS Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/qt6.11-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "qt6.11-release",
      "displayName": "Qt 6.11 macOS Release",
      "inherits": "qt6.11-debug",
      "binaryDir": "${sourceDir}/build/qt6.11-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "qt6.11-debug",
      "configurePreset": "qt6.11-debug"
    },
    {
      "name": "qt6.11-release",
      "configurePreset": "qt6.11-release"
    }
  ]
}
