function(mqtt_plus_thin_macos_bundle bundle architectures)
    if(NOT IS_DIRECTORY "${bundle}")
        message(FATAL_ERROR "macOS bundle directory not found: ${bundle}")
    endif()
    if(NOT architectures)
        message(FATAL_ERROR "Explicit macOS architectures are required for bundle thinning")
    endif()
    find_program(mqtt_plus_lipo lipo REQUIRED)
    file(GLOB_RECURSE bundle_files LIST_DIRECTORIES FALSE "${bundle}/*")
    set(thinned_count 0)
    foreach(binary IN LISTS bundle_files)
        if(IS_SYMLINK "${binary}")
            continue()
        endif()
        # Inspect the header rather than the extension: framework executables
        # have no extension, and resource files must never be passed to lipo.
        file(READ "${binary}" magic LIMIT 4 HEX)
        if(NOT magic MATCHES "^(cffaedfe|feedfacf|cefaedfe|feedface|cafebabe|bebafeca|cafebabf|bfbafeca)$")
            continue()
        endif()
        execute_process(COMMAND "${mqtt_plus_lipo}" -archs "${binary}"
            OUTPUT_VARIABLE available_archs OUTPUT_STRIP_TRAILING_WHITESPACE
            COMMAND_ERROR_IS_FATAL ANY)
        separate_arguments(available_archs UNIX_COMMAND "${available_archs}")
        foreach(arch IN LISTS architectures)
            if(NOT arch IN_LIST available_archs)
                message(FATAL_ERROR "Bundled binary is missing architecture ${arch}: ${binary}")
            endif()
        endforeach()
        list(LENGTH available_archs available_count)
        list(LENGTH architectures requested_count)
        if(available_count EQUAL requested_count)
            continue()
        endif()
        set(lipo_options)
        foreach(arch IN LISTS architectures)
            if(requested_count EQUAL 1)
                list(APPEND lipo_options -thin "${arch}")
            else()
                list(APPEND lipo_options -extract "${arch}")
            endif()
        endforeach()
        execute_process(COMMAND "${mqtt_plus_lipo}" "${binary}"
            ${lipo_options} -output "${binary}"
            COMMAND_ERROR_IS_FATAL ANY)
        math(EXPR thinned_count "${thinned_count} + 1")
    endforeach()
    message(STATUS "Removed unused macOS architectures from ${thinned_count} bundled binaries")
endfunction()
